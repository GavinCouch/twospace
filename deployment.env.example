# Development: omit cloud credentials and run npm run dev.
# Production: set these in the hosting provider's secret environment settings.
TWOSPACE_STORAGE=cloud
BETTER_AUTH_URL=https://your-domain.example
BETTER_AUTH_SECRET=
DATABASE_URL=
# Optional PEM certificate for a database whose CA is not in the system trust store.
DATABASE_SSL_CA=

# Preferred storage: a PRIVATE Supabase bucket. This key stays server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=twospace-media
# A legacy JWT service_role key can be used instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Alternative to Supabase Storage: private S3-compatible storage.
# Leave SUPABASE_URL unset when using this option.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google web OAuth; callback: https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verify the sender's domain in Resend before enabling real email accounts.
RESEND_API_KEY=
EMAIL_FROM=TwoSpace <accounts@your-domain.example>
