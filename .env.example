# Local development works without external services.
TWOSPACE_STORAGE=local
BETTER_AUTH_URL=http://127.0.0.1:3100

# Optional local data directory. Defaults to ./data (ignored by Git).
# TWOSPACE_DATA_DIR=/absolute/path/to/local-data

# Production needs cloud storage, an HTTPS origin, and a persistent secret.
# Replace the two local values above; do not declare each variable twice.
# TWOSPACE_STORAGE=cloud
# BETTER_AUTH_URL=https://your-domain.example
# BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL_CA=optional-PEM-certificate-with-escaped-newlines
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_STORAGE_BUCKET=twospace-media
# SUPABASE_SECRET_KEY=your-server-only-key

# Email: configure the whole group to enable delivery.
# EMAIL_PROVIDER=brevo
# EMAIL_FROM=TwoSpace <verified-sender@your-domain.example>
# BREVO_API_KEY=your-transactional-email-key
# For Resend instead, set EMAIL_PROVIDER=resend and RESEND_API_KEY.

# Google sign-in: configure both values together.
# GOOGLE_CLIENT_ID=your-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# Spotify catalog search: configure both values together.
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# SPOTIFY_MARKET=US

# See docs/configuration.md for S3-compatible storage and deployment details.
# Keep real credentials in ignored .env.local or your hosting secret store.
